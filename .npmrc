# For 15-25% faster npm install
# https://www.peterbe.com/plog/benchmarking-npm-install-with-or-without-audit
# Also we have Dependabot alerts configured in the GitHub repo.
audit=false
fund=false

# Use the public registry even when a global npm config points elsewhere,
# so npm ci fetches the same packages as CI and the Docker build.
registry=https://registry.npmjs.org/

# Skip package versions published in the last 7 days, matching the Dependabot cooldown.
# Needs npm 11.10 or later.
min-release-age=7
